
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BetOption {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum GameStatus {
  SCHEDULED
  CLOSED
  FINISHED
}

enum GameType {
  LEAGUE_GROUP
  KNOCKOUT
}

enum Role {
  ADMIN
  MODERATOR
  PLAYER
  PENDING
}

model User {
  id        String   @id @default(cuid())

  name      String?
  email     String   @unique
  image     String?

  provider  String?  
  providerId String?  

  role      Role      @default(PENDING)

  bets      Bet[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Team {
  id String @id @default(cuid())

  name String @unique
  logoUrl String?

  homeGames Game[] @relation("GameHomeTeam")
  awayGames Game[] @relation("GameAwayTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Competition {
  id String @id @default(cuid())

  name String @unique
  logoUrl String?

  games Game[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id String @id @default(cuid())

  gameDate DateTime
  betCloseAt DateTime

  moreInfo String? @db.Text

  status GameStatus @default(SCHEDULED)
  gameType GameType @default(LEAGUE_GROUP)
  homeTeamId String?
  awayTeamId String?
  competitionId String?

  homeScore Int?
  awayScore Int?
  secondLegHomeScore Int?
  secondLegAwayScore Int?
  penaltyHomeScore Int?
  penaltyAwayScore Int?

  bets Bet[]
  homeTeamRef Team? @relation("GameHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamRef Team? @relation("GameAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  competitionRef Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameDate])
  @@index([status])
  @@index([gameType])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([competitionId])
}

model Bet {
  id String @id @default(cuid())

  userId String
  gameId String

  option BetOption

  isCorrect Boolean?
  pointsAwarded Int @default(0)
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastEditedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId])
  @@index([gameId, settledAt])
}

model BlogPost {
  id        String   @id @default(cuid())

  title     String
  slug      String   @unique
  content   String   @db.Text

  published Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Config {
  id                     String @id @default("singleton")
  betCloseMinutesBefore  Int    @default(30)
  rankingSeasons         Json   @default("[]")

  updatedAt DateTime @updatedAt
}