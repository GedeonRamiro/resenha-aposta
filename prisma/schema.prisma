
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BetOption {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum GameStatus {
  SCHEDULED
  CLOSED
  FINISHED
}

enum Role {
  ADMIN
  MODERATOR
  PLAYER
  PENDING
}

model User {
  id        String   @id @default(cuid())

  name      String?
  email     String   @unique
  image     String?

  provider  String?  
  providerId String?  

  role      Role      @default(PENDING)

  bets      Bet[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Game {
  id String @id @default(cuid())

  homeTeam String
  awayTeam String
  competition String?

  gameDate DateTime
  betCloseAt DateTime

  moreInfo String? @db.Text

  status GameStatus @default(SCHEDULED)

  homeScore Int?
  awayScore Int?

  bets Bet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameDate])
  @@index([status])
  @@index([competition])
}

model Bet {
  id String @id @default(cuid())

  userId String
  gameId String

  option BetOption

  isCorrect Boolean?
  pointsAwarded Int @default(0)
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastEditedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId])
  @@index([gameId, settledAt])
}

model BlogPost {
  id        String   @id @default(cuid())

  title     String
  slug      String   @unique
  content   String   @db.Text

  published Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}